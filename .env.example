# TEMPLATE ONLY — documents every variable this service accepts.
# Never loaded by the app, Docker Compose, or deployment tooling.
# Copy it once to create your real, git-ignored config:
#   cp .env.example .env

# development | production
APP_ENV=development

# debug | info | warn | error
LOG_LEVEL=debug

HTTP_PORT=8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s

# Used by the app.
DATABASE_URL=postgres://beebase:beebase@localhost:5436/beebase_media?sslmode=disable
DATABASE_CONNECT_TIMEOUT=5s

# Used by docker-compose to provision the postgres container.
POSTGRES_USER=beebase
POSTGRES_PASSWORD=beebase
POSTGRES_DB=beebase_media

# Used only by `make test-integration`, never by the app itself.
TEST_DATABASE_URL=postgres://beebase:beebase@localhost:5436/beebase_media_test?sslmode=disable

# Required: the shared session store. Every BeeBase service (not just
# auth-service) checks it on every request, so an access token can be
# rejected the instant its session is superseded by a newer one instead
# of staying valid until its own JWT expiry.
REDIS_ADDR=localhost:6379
REDIS_CONNECT_TIMEOUT=5s
# `docker compose up` (via beebase-gateway) overrides this to the
# in-network Redis address — you don't need to change it for that path.

# Required: auth-service's public key endpoint, used to verify access
# tokens without ever holding a key that could mint one.
AUTH_JWKS_URL=http://localhost:8081/.well-known/jwks.json

# Required: the gateway's externally reachable base URL, used to build
# the image_url returned for each media item (PUBLIC_BASE_URL +
# "/api/v1/media/{id}/download"). Unlike every other URL setting in this
# file, this one is handed to clients, so it must resolve for them, not
# just for server-to-server calls — it must stay the gateway's address
# even under `docker compose up`, which does NOT override it.
PUBLIC_BASE_URL=http://localhost:8080

# Maximum size, in bytes, of a single uploaded file. Default: 15MB.
MAX_UPLOAD_SIZE_BYTES=15728640

# Required: file content is stored in Amazon S3, not PostgreSQL (see
# README's Storage section). Credentials are always resolved by the AWS
# SDK's default chain (e.g. a local `aws configure` profile, or
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY env vars, for local
# development; the EC2 instance's IAM role in production) - there is no
# app-level credential configuration.
STORAGE_BUCKET=beebase-media
STORAGE_REGION=us-east-1
STORAGE_CONNECT_TIMEOUT=5s

# `docker compose up` (via beebase-gateway) overrides the URLs above
# to in-network addresses — you don't need to change them for that path.
